# Life OS Ref - .gitignore

# Git & OS
.DS_Store
Thumbs.db
*.swp
*.bak
*.log

# Environment & Secrets
.env
.env.local
.env.*.local

# Java / Maven
backend/target/
backend/**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Node / Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.turbo/
frontend/build/
*.tsbuildinfo

# IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# Uploads
uploads/
backend/uploads/
