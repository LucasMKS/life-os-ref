# ==========================================
# Life OS Monolith - Environment Variables
# ==========================================

# ------------------------------------------
# 1. SECURITY & AUTH (OBRIGATÓRIO)
# ------------------------------------------
# Chave secreta compartilhada para validação do JWT gerado pelo LMS-Filmes.
# IMPORTANTE: Deve ser EXATAMENTE a mesma chave configurada no serviço do LMS-Filmes!
JWT_SECRET=troque_por_um_segredo_jwt_base64_ou_string_longa_e_segura

# ------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------
# Credenciais do banco (usadas pelo container do Postgres e pelo Backend)
POSTGRES_DB=lifeos_db
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos_password
# Porta exposta no seu computador (Host). 
# Se a porta 5432 já estiver ocupada pelo Postgres nativo do Windows, altere para 5433:
POSTGRES_PORT=5432

# ------------------------------------------
# 3. INTEGRAÇÃO COM ECOSSISTEMA LMS (OPCIONAL)
# ------------------------------------------
# No ambiente local (Windows), para sincronizar com a sua API em produção:
# LMSFAVORITE_URL=https://api-filmes.lucasmks.com.br/lms-favorite
# LMSRATING_URL=https://api-filmes.lucasmks.com.br/lms-rating
# Na VPS/Linux caso estejam na mesma rede docker:
LMSFAVORITE_URL=http://lmsfavorite:8083
LMSRATING_URL=http://lmsrating:8082

# ------------------------------------------
# 4. NOTIFICAÇÕES & TELEGRAM BOT (OPCIONAL)
# ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BOT_USER_ID=
SITE_URL=http://localhost:3000

# ------------------------------------------
# 5. APIS EXTERNAS & MÓDULOS (OPCIONAIS)
# ------------------------------------------
# Cinema & Séries (TMDB)
TMDB_API_KEY=

# Games (Steam & Twitch)
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Clima (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=

# Livros (Google Books)
GOOGLE_BOOKS_API_KEY=

# Esportes & F1 (API-Football & PandaScore)
API_FOOTBALL_KEY=
PANDASCORE_API_KEY=

# ------------------------------------------
# 6. CORS (BACKEND)
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://lifeos.lucasmks.com.br
